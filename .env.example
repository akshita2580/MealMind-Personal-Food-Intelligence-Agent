# Swiggy MCP Server Configuration
# Copy this file to .env and adjust values as needed

# Database Configuration (PostgreSQL)
# Example for local PostgreSQL; use your provider's URL in deployment.
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mealmind
# Existing cloud URLs beginning with postgres:// or postgresql:// are supported.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mealmind

# Server Configuration
# HTTP server port for REST API
# Default: 8000
PORT=8000

# Frontend URL (for OAuth redirects)
# Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Swiggy API Configuration
# Base URL for Swiggy order API endpoint
# Default: https://www.swiggy.com/dapi/order/all
SWIGGY_API_URL=https://www.swiggy.com/dapi/order/all

# HTTP request timeout in seconds for API calls
# Default: 30
REQUEST_TIMEOUT=30

# OAuth Canonical Callback URI
# Default: http://127.0.0.1:8000/api/auth/swiggy/callback
SWIGGY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/swiggy/callback

# Environment (development or production)
# Default: development
ENVIRONMENT=development

# Encryption Key for securing tokens (Required in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Database Connection Pool Configuration (PostgreSQL only)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true

# Official Swiggy MCP servers — update_food_cart writes the same account cart the Swiggy app shows
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout

# Insight Engine Thresholds (optional - defaults shown)
# INSIGHT_MIN_ORDERS_PATTERNS=10
# INSIGHT_MIN_ORDERS_TRENDS=5
# INSIGHT_MIN_ORDERS_LOYALTY=8
# INSIGHT_MIN_ORDERS_CUISINE=7
# INSIGHT_MIN_ORDERS_DAY_PATTERN=14
# INSIGHT_MIN_ORDERS_HOUR_PATTERN=10
# INSIGHT_MIN_ORDERS_LATE_NIGHT=5
# INSIGHT_MIN_ORDERS_PER_RESTAURANT=3
# INSIGHT_MIN_ORDERS_REPEAT_ITEMS=8
# INSIGHT_MIN_ITEM_OCCURRENCES=3
# INSIGHT_MIN_MONTHS_COMPARISON=2
# INSIGHT_MIN_DISCOUNTED_ORDERS=3

