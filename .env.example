# Swiggy MCP Server Configuration
# Copy this file to .env and adjust values as needed

# Database Configuration
# Path to SQLite database file (relative or absolute)
# Default: data/swiggy.db
DATABASE_URL=data/swiggy.db

# Server Configuration
# HTTP server port for REST API
# Default: 8000
PORT=8000

# Swiggy API Configuration
# Base URL for Swiggy order API endpoint
# Default: https://www.swiggy.com/dapi/order/all
SWIGGY_API_URL=https://www.swiggy.com/dapi/order/all

# HTTP request timeout in seconds for API calls
# Default: 30
REQUEST_TIMEOUT=30
